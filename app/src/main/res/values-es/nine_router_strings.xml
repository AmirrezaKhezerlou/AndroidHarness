    <string name="nine_router_uninstall">Desinstalar 9Router</string>
    <string name="nine_router_uninstall_title">¿Desinstalar 9Router por completo?</string>
    <string name="nine_router_uninstall_body">Detiene 9Router y elimina su instalación, las cuentas guardadas, las claves de API del enrutador, la configuración, la caché, la preferencia de inicio automático y las conexiones de proveedor de la app. Esto no se puede deshacer. La cadena de herramientas de Linux compartida sigue disponible para otras funciones.</string>
