    <string name="nine_router_provider_body">Inicia 9Router si hace falta y rellena su punto de acceso local y su clave de API automáticamente. Los modelos conectados aparecen en los selectores de modelos de Chat y Código.</string>
    <string name="nine_router_remove_provider">Quitar de los proveedores</string>
